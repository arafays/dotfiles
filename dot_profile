# ~/.profile — POSIX login shell environment
# Sourced by SDDM (wayland-session script), bash/zsh login shells.
# Fish gets the same variables from systemd via config.fish's
# systemctl --user show-environment import (no fenv plugin needed).

# System-wide profile
[ -f /etc/profile ] && . /etc/profile

# Canonical user environment — single source of truth:
# ~/.config/environment.d/*.conf (also read natively by systemd --user).
# set -a auto-exports everything so the SDDM session inherits it.
_env_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
if [ -d "$_env_dir" ]; then
  set -a
  for _env_file in "$_env_dir"/*.conf; do
    [ -f "$_env_file" ] && . "$_env_file"
  done
  set +a
fi
unset _env_dir _env_file

# GPG TTY (runtime — needs a real tty, cannot live in environment.d)
command -v tty >/dev/null 2>&1 && export GPG_TTY="$(tty 2>/dev/null)"

# PATH — shell-specific, idempotent additions (never put PATH in environment.d)
_prepend() {
  case ":$PATH:" in *:"$1":*) ;; *) PATH="$1:$PATH" ;; esac
}
_prepend "$HOME/.local/bin"
_prepend "$HOME/.opencode/bin"

export PATH
unset -f _prepend
