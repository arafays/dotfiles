XDG_PROJECTS_DIR="${XDG_PROJECTS_DIR:-$HOME/projects}"

XDG_MENU_PREFIX=arch-

FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
FZF_DEFAULT_OPTS="--layout=reverse --border --preview 'bat --color=always --style=numbers --line-range=:500 {}' --preview-window=right:60%"

MANPAGER="sh -c 'col -bx | bat -l man -p --color always'"
MANROFFOPT="-c"

WGETRC="${XDG_CONFIG_HOME}/wgetrc"
BAT_THEME="ansi"
BAT_PAGER="less -RF"

WGPU_BACKEND=gl
CONTEXT7_API_KEY="{{ .secrets.context7_api_key }}"
EXA_API_KEY="{{ .secrets.exa_api_key }}"
