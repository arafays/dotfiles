source /usr/share/cachyos-fish-config/cachyos-config.fish

set -gx FZF_DEFAULT_OPTS '--color=bg:-1,bg+:-1,fg:#dde1e6,fg+:#ffffff,border:#ffc799,hl:#99ffe4,hl+:#ffc799,info:#45475A,prompt:#ffc799,pointer:#ffc799,marker:#99ffe4,spinner:#ffc799,header:#99ffe4 --border=rounded --layout=reverse'

set -gx EDITOR nvim
set -gx SUDO_EDITOR nvim
set -gx BROWSER zen-browser

set -gx GPG_TTY $TTY

fish_add_path $HOME/.local/share/mise/shims
fish_add_path $HOME/.local/bin
fish_add_path $HOME/.opencode/bin

set -gx OPENROUTER_API_KEY '{{ .secrets.openrouter_api_key }}'
set -gx BW_SESSION '{{ .secrets.bw_session }}'
set -Ux PORTLESS_NGROK 1

set -gx CHROMIUM_PATH (command -v chromium || command -v google-chrome || echo "xdg-open")

for line in (systemctl --user show-environment 2>/dev/null)
    set -l pair (string split --max 1 '=' -- $line)
    set -l key $pair[1]
    contains -- $key PWD SHLVL _ PATH; and continue
    set -l val $pair[2]
    set -l _dollar_quote (printf '\x24\x27')
    if test (string sub -l 2 -- $val) = "$_dollar_quote"
        set val (string sub -s 3 -- $val | string sub -e -1)
        set val (string replace -a "\\'" "'" -- $val)
    end
    set -gx $key $val
end

function fish_greeting
end

function __cached_source --description "Cache and source a generator's output"
    set -l bin (command -v $argv[1]); or return 1
    set -l cache $argv[2]
    if not test -f "$cache"; or test "$cache" -ot "$bin"
        mkdir -p (dirname "$cache")
        $argv[3..] >"$cache" 2>/dev/null
    end
    test -s "$cache"; and source "$cache"
end

function __deferred_init --on-event fish_prompt
    set -l cache_dir "$XDG_CACHE_HOME"
    test -n "$cache_dir"; or set cache_dir "$HOME/.cache"
    set -l cache "$cache_dir/fish/init"

    __cached_source starship "$cache/starship.init.fish" starship init fish --print-full-init
    __cached_source mise "$cache/mise.activate.fish" mise activate fish
    __cached_source mise "$cache/mise.completions.fish" mise completion fish
    __cached_source zoxide "$cache/zoxide.init.fish" zoxide init fish --cmd cd
    __cached_source herdr "$cache/herdr.completions.fish" herdr completion fish

    __cached_source bun "$cache/bun.fish" bun completions fish
    __cached_source pnpm "$cache/pnpm.fish" pnpm completion fish

    __cached_source aube "$cache/aube.activate.fish" aube activate fish
    __cached_source aube "$cache/aube.completions.fish" aube completion fish
    __cached_source opencode2 "$cache/opencode2.fish" opencode2 --completions fish

    functions -e __deferred_init __cached_source
end

if status is-interactive
    set -g fish_cursor_default block
    set -g fish_cursor_insert line
    set -g fish_cursor_replace_one underscore
    set -g fish_cursor_replace underscore
    set -g fish_cursor_external line
    set -g fish_cursor_visual block
    fish_vi_key_bindings

    # Must be defined AND invoked after fish_vi_key_bindings,
    # otherwise fish never applies these binds (vi-mode init won't
    # pick up a function defined later in the file).
    function fish_user_key_bindings
        bind \ep parufind-widget
        bind -M insert \ch backward-delete-char
        bind -M insert \cf forward-char
    end
    fish_user_key_bindings

    abbr g git
    abbr lzg lazygit
    abbr lzd lazydocker
    abbr oc opencode2

    alias vim='nvim'
    abbr -a -- - 'cd -'
    alias n='nvim'
    alias code="code-insiders"
    alias dev='code .'
    alias czd='chezmoi cd'
    alias npx="aubx"
    alias opencode="opencode2"
    alias fish_clearn_cache="rm -rf ~/.cache/fish/init"

    function mkcd
        mkdir -p $argv; and cd $argv
    end

    if type -q eza
        alias ls='eza -lh --icons=auto --group-directories-first'
        alias ll='eza -lha --icons=auto --sort=name --group-directories-first'
        alias l='eza -lh --icons=auto'
        alias la='eza -lha --icons=auto'
        alias ld='eza -lhD --icons=auto'
        alias lt='eza --icons=auto --tree --level=2'
    end

    if type -q bat
        alias cat='bat --style=plain --color=always --paging=never'
        alias less='bat --style=plain --color=always --paging=always'
    end

    if type -q fd
        alias find='fd'
    end

    function fcd
        set -l dir (find . -maxdepth 5 \( -name .git -o -name node_modules -o -name .next -o -name dist \) -prune -o -type d -print 2>/dev/null | fzf --height=60% --layout=reverse --preview='eza -la --icons=auto {}' --preview-window=right:60%)
        test -n "$dir"; and cd "$dir"
    end

    set -gx aurhelper ""
    for helper in yay paru
        if type -q $helper
            set -gx aurhelper $helper
            alias un="$helper -Rns"
            alias up="$helper -Syu --noconfirm"
            alias look="$helper -Qs"
            alias search="$helper -Ss"
            alias pc="$helper -Sc"
            alias po="$helper -Qtdq | $helper -Rns -"
            alias psi="$helper -Si"
            alias orphans="$helper -Qtdq"
            alias ua-drop-caches="sudo paccache -rk3; $helper -Sc --aur --noconfirm"
            break
        end
    end

    function in
        if test -n "$aurhelper"
            $aurhelper -S $argv
        else
            sudo pacman -S $argv
        end
    end

    function tn
        set -l session_name (basename $PWD | string replace -a '.' '_')
        tmux new-session -A -s "$session_name" -c "$PWD"
    end

    function ts
        set -l ses (tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf --layout=reverse)
        if test -n "$ses"
            if test -n "$TMUX"
                tmux switch-client -t "$ses"
            else
                tmux attach-session -t "$ses"
            end
        end
    end

    function hn
        if not type -q herdr
            echo "herdr not installed" >&2
            return 1
        end
        set -l ws_name (basename $PWD | string replace -a '.' '_')
        if set -q HERDR_SOCKET_PATH
            set -l pane_id $HERDR_ACTIVE_PANE_ID
            if test -z "$pane_id"
                set pane_id (herdr pane current --pane --current 2>/dev/null | jq -r '.id // empty')
            end
            if test -n "$pane_id"
                herdr pane move "$pane_id" --new-workspace --label "$ws_name" --focus 2>/dev/null
            else
                echo "Could not detect current pane" >&2
            end
        else
            echo "Launching herdr..."
            herdr
        end
    end

    function hs
        if not type -q herdr
            echo "herdr not installed" >&2
            return 1
        end
        set -l ses (herdr session list --json 2>/dev/null | jq -r '.[].name' | fzf --layout=reverse)
        if test -n "$ses"
            herdr session attach "$ses"
        end
    end

    function compress
        set -l archive $argv[1]
        set -e argv[1]
        switch $archive
            case '*.tar.gz'
                tar -czf $archive $argv
            case '*.zip'
                zip -r $archive $argv
            case '*.7z'
                7z a $archive $argv
            case '*'
                echo "Unsupported format"
        end
    end

    function extract
        set -l archive $argv[1]
        switch $archive
            case '*.tar.gz' '*.tgz'
                tar -xzf $archive
            case '*.zip'
                unzip $archive
            case '*.7z'
                7z x $archive
            case '*'
                echo "Unsupported format"
        end
    end

    function parufind
        set -l pkg (paru -Ss "$argv" 2>/dev/null | awk '/^[a-z]/ {if (p != "") print p " | " d; p = $1; d = ""} /^    / {sub(/^    /, ""); d = $0} END {if (p != "") print p " | " d}' | fzf --ansi --height=80% --layout=reverse --border=rounded --preview='echo {} | cut -d "|" -f1 | tr -d " " | xargs -I{} paru -Si {}' | cut -d '|' -f1 | tr -d ' ')
        if test -n "$pkg"
            paru -S (echo $pkg | string trim)
        end
    end

    function parufind-widget
        read -P "Search AUR: " search
        test -n "$search"; and parufind "$search"
        commandline -f repaint
    end

    function ua-update-all
        type -q rate-mirrors; or return
        set -l TMPFILE (mktemp)
        if rate-mirrors --save=$TMPFILE arch --max-delay=21600
            sudo mv $TMPFILE /etc/pacman.d/mirrorlist
            sudo paccache -rk3
            test -n "$aurhelper"; and $aurhelper -Sc --aur --noconfirm
            $aurhelper -Syyu --noconfirm
        end
    end

    function zipclean
        set -l archive $argv[1]
        set -e argv[1]
        zip -r $archive $argv -x "*/node_modules/*" -x "*/dist/*"
    end

    function tarclean
        set -l archive $argv[1]
        set -e argv[1]
        tar --exclude='*/node_modules/*' --exclude='*/dist/*' -czf $archive $argv
    end

    function compress-project
        set -l archive $argv[1]
        set -e argv[1]
        tar --exclude='node_modules' --exclude='dist' -czf $archive $argv
    end

    function compress-projects
        set -l dry_run 0
        set -l archive ""
        set -l args ()
        set -l excludes \
            node_modules .next .astro .svelte-kit .nuxt .output .turbo .vercel .expo \
            dist build out target __pycache__ .venv venv .ruff_cache .mypy_cache \
            .pytest_cache .cache .yarn .pnpm-store .direnv '*.pyc' .DS_Store \
            .terraform ios/build android/build .gradle .swiftpm Pods DerivedData \
            .nx .serverless coverage .nyc_output .eslintcache .parcel-cache \
            .angular .storybook/out .netlify

        for arg in $argv
            switch $arg
                case --dry-run -n
                    set dry_run 1
                case '*'
                    if test -z "$archive"
                        set archive $arg
                    else
                        set -a args $arg
                    end
            end
        end

        if test -z "$archive"
            set archive ../(basename $PWD)-(date +%Y%m%d).tar.gz
        end

        if test (count $args) -eq 0
            set args .
        end

        set -l exclude_flags
        for dir in $excludes
            set -a exclude_flags --exclude=$dir
        end

        if test $dry_run -eq 1
            noglob tar $exclude_flags -czvf /dev/null $args
        else
            noglob tar $exclude_flags -czf $archive $args
        end
    end

end
