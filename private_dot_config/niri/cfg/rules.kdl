// ────────────── Global Window Style ──────────────
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}

// ────────────── Noctalia ──────────────
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

// ────────────── Steam ──────────────
// Popups and toasts float; the main window tiles.
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// ────────────── Floating Utility Windows ──────────────
window-rule {
    open-floating true
    default-column-width { fixed 1734; }
    default-window-height { fixed 1024; }

    match app-id="^nemo$"
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id="^cachyos-pi$"
    match app-id=r#"^org\.gnome\.Zenity$"#
    match app-id="Emulator"
    match app-id=r#"dev\.zed\.Zed$"# title=r#"Settings"#
    match app-id=r#"dev\.zed\.Zed$"# title=r#"Project Structure"#
    match app-id=r#"^nwg-look$"#
    match app-id=r#"^qt6ct$"#
    match app-id=r#"^avdmanager$"#
    match app-id=r#"^warp-taskbar$"#
    match title=r#"AVD|Virtual Device"#
    match title=r#"(?i)Extension.*Bitwarden"#
}

// ────────────── Browsers (DP-3) ──────────────
window-rule {
    match app-id="^zen$"
    match app-id="^brave-browser$"
    match app-id="^chromium$"
    exclude title=r#"(?i)Extension.*Bitwarden"#
    open-on-output "DP-3"
    open-maximized-to-edges true
    open-maximized true
    default-column-width { proportion 1.0; }
    background-effect {
        blur true
    }
}

// ────────────── Terminals ──────────────
window-rule {
    match app-id="^Alacritty$"
    open-maximized-to-edges true
    open-maximized true
    default-column-width { proportion 1.0; }
    border {
        off
    }
    background-effect {
        blur true
    }
}

// ────────────── Dev Tools (DP-3) ──────────────
window-rule {
    match app-id=r#"^code(-insiders)?$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^zcode$"#
    match app-id=r#"^cursor$"#
    open-on-output "DP-3"
    draw-border-with-background true
    default-column-width { proportion 0.85556; }
    background-effect {
        blur true
    }
}

// ────────────── Chat (DP-3, floating) ──────────────
window-rule {
    match app-id=r#"(?i)^slack$"#
    match app-id="^discord$"
    match app-id="^vesktop$"
    open-on-output "DP-3"
    open-floating true
}

// ────────────── Side Monitor Apps (HDMI-A-1) ──────────────
window-rule {
    match app-id="^privateinternetaccess$"
    open-on-output "HDMI-A-1"
}

// ────────────── Screencast Privacy ──────────────
window-rule {
    match app-id="^Upwork$"
    match app-id="^Bitwarden$"
    match app-id=r#"(?i)^slack$"#
    match app-id="^vesktop$"
    match app-id="^zen$" title=r#"(?i)\bPrivate\b"#
    match app-id="^brave-browser$" title=r#"(?i)\bIncognito\b"#
    block-out-from "screencast"
}

// ────────────── Games & Launchers (DP-3) ──────────────
window-rule {
    match app-id="^steam_app_default$"
    match app-id=r#"^steam_app_\d+$"#
    match app-id="^steam$"
    match app-id=r#"^net\.lutris\.Lutris$"#
    match app-id="^faugus-launcher$"
    match app-id="^Heroic$"
    match app-id="^gamescope$"
    match app-id="^Goverlay$"
    match app-id="^protontricks$"
    open-on-output "DP-3"
}

window-rule {
    match app-id="^steam_app_default$"
    match app-id=r#"^net\.lutris\.Lutris$"#
    match app-id="^faugus-launcher$"
    match app-id="^Goverlay$"
    match app-id="^protontricks$"
    open-floating true
}

window-rule {
    match app-id="^steam$"
    match app-id="^Heroic$"
    open-maximized-to-edges true
    open-maximized true
    default-column-width { proportion 1.0; }
}

// ────────────── Downloads ──────────────
window-rule {
    match app-id=r#"^org\.qbittorrent\.qBittorrent$"#
    open-floating true
    default-column-width { fixed 1734; }
    default-window-height { fixed 1024; }
    default-floating-position x=520 y=252
}
