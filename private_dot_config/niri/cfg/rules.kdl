// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}


// Global blur for all windows (noctalia recommended)
window-rule {
    background-effect {
        blur true
        xray true
    }
}

// Floating Noctalia settings window (docs recommendation)
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Noctalia surfaces blur
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

// Enable blur on noctalia's window switcher and disable xray
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Window-Rules

// Enable borders for Alacritty since it no longer has window decorations
// Opacity + blur for a translucent terminal look.
// NOTE: transparency comes client-side from alacritty.toml (`window.opacity = 0.8`);
// do NOT add a compositor `opacity` here — niri's rule opacity multiplies on top.
// draw-border-with-background false: draw the focus ring AROUND the window instead
// of as a solid rectangle behind it (which would show through the translucency).
window-rule {
    match app-id="^Alacritty$"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
    default-column-width { proportion 0.8887; }
    border {
      off
    }
}

// Compositor-side translucency for apps that have no native opacity setting.
// Browsers (chromium/zen) are deliberately left out: it dims page content.
window-rule {
    match app-id=r#"^slack$"#
    match app-id=r#"code(-insiders)?$"#
    match app-id=r#"dev\.zed\.Zed$"#
    // match app-id=r#"^(discord|Signal|obsidian|org\.telegram\.desktop)$"#
    opacity 0.95

    // Popup menus are separate surfaces and stay opaque; blur them to match,
    // with the same corner radius as the global rounding rule above.
    popups {
        geometry-corner-radius 8
        background-effect {
            blur true
        }
    }
}

// Optional: dim unfocused windows for depth. Stacks multiplicatively with the
// rules above (inactive Alacritty becomes 0.8 * 0.95).
// window-rule {
//     match is-active=false
//     opacity 0.95
// }


window-rule {
    match app-id="chromium"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"zen$"#
    default-column-width { proportion 1.0; }
    open-maximized true
    open-maximized-to-edges true
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    open-floating true
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

window-rule {
    match app-id="Emulator" title=r#"^Android Emulator"#
    open-floating true
    draw-border-with-background false
    geometry-corner-radius 0
    clip-to-geometry false
    focus-ring { off; }
    border { off; }
}


window-rule {
    match app-id="Emulator"
    match app-id=r#"dev\.zed\.Zed$"# title=r#"Settings|About Zed|Project Structure"#
    draw-border-with-background false
    open-floating true
    focus-ring { off; }
    border { off; }
}

window-rule {
    match app-id=r#"^avdmanager$"#
    match app-id=r#"^sun-awt-X11-XFramePeer$"# title=r#"AVD|Virtual Device"#
    open-floating true
    draw-border-with-background true
    geometry-corner-radius 0
    clip-to-geometry false
}

// vscode should have borders
window-rule {
  // regex that mantaches code and code-insiders
    match app-id=r#"code(-insiders)?$"#
    // for zed thats match id id dev.zed.Zed
    match app-id=r#"dev\.zed\.Zed$"#
    // false: draw ring around the window; a background rectangle would show
    // through their 0.95 compositor transparency (rule above).
    draw-border-with-background false
    default-column-width { proportion 1.0; }
}
