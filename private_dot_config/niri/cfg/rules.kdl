// ────────────── Global Window Style ──────────────
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}

// ────────────── Noctalia ──────────────
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

// ────────────── Steam ──────────────
// Popups and toasts float; the main window tiles.
window-rule {
    match app-id="steam"
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// ────────────── Floating Utility Windows ──────────────
window-rule {
    open-floating true
    default-column-width { fixed 1734; }
    default-window-height { fixed 1024; }

    match app-id="^nemo$"
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id="^cachyos-pi$"
    match app-id=r#"^org\.gnome\.Zenity$"#
    match app-id="Emulator"
    match app-id=r#"dev\.zed\.Zed$"# title=r#"Settings"#
    match app-id=r#"dev\.zed\.Zed$"# title=r#"Project Structure"#
    match app-id=r#"^nwg-look$"#
    match app-id=r#"^qt6ct$"#
    match app-id=r#"^avdmanager$"#
    match app-id=r#"^warp-taskbar$"#
    match title=r#"AVD|Virtual Device"#
    match title=r#"(?i)Extension.*Bitwarden"#
}

// ────────────── Browsers (DP-3) ──────────────
window-rule {
    match app-id="^zen$"
    match app-id="^brave-browser$"
    match app-id="^chromium$"
    match app-id="^Chatgpt$"
    exclude title=r#"(?i)Extension.*Bitwarden"#
    exclude title=r#"(?i)Extension"#
    exclude title=r#"Download file info · Hurtle"#
    exclude title=r#"(?i)^Picture[- ]in[- ][Pp]icture$"#
    open-on-output "DP-3"
    open-maximized-to-edges true
    open-maximized true

    default-column-width { proportion 1.0; }
    background-effect {
        blur true
    }
}

// ────────────── Terminals ──────────────
window-rule {
    match app-id="^Alacritty$"
    match app-id="^com.mitchellh.ghostty$"
    open-maximized-to-edges true
    open-maximized true
    default-column-width { proportion 1.0; }
    draw-border-with-background false
    border {
        off
    }
    background-effect {
        blur true
        xray true
    }
}

// ────────────── Dev Tools (DP-3) ──────────────
window-rule {
    match app-id=r#"^code(-insiders)?$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^zcode$"#
    match app-id=r#"^cursor$"#
    open-on-output "DP-3"
    draw-border-with-background true
    default-column-width { proportion 0.85556; }
    background-effect {
        blur true
    }
}

// ────────────── Chat (DP-3, floating) ──────────────
window-rule {
    match app-id=r#"(?i)^slack$"#
    match app-id="^discord$"
    match app-id="^vesktop$"
    match app-id="^handy$"
    match app-id="^com.shellyorg.shelly$"
    open-on-output "DP-3"
    open-floating true
}

// ────────────── Side Monitor Apps (HDMI-A-1) ──────────────
window-rule {
    match app-id="^privateinternetaccess$"
    open-on-output "HDMI-A-1"
}

// ────────────── Screencast Privacy ──────────────
window-rule {
    match app-id="^Upwork$"
    match app-id="^Bitwarden$"
    match app-id=r#"(?i)^slack$"#
    match app-id="^vesktop$"
    match app-id="^zen$" title=r#"(?i)\bPrivate\b"#
    match app-id="^brave-browser$" title=r#"(?i)\bIncognito\b"#
    block-out-from "screencast"
}

// ────────────── Games & Launchers (DP-3) ──────────────
// app-id below is the Wayland app_id, which for GTK/Electron apps is the
// Gtk.Application application_id / StartupWMClass from the .desktop file,
// NOT the binary name. Verified against `niri msg windows` on this machine:
//   Lutris    net.lutris.Lutris                (was already correct)
//   Faugus    io.github.Faugus.faugus-launcher  (was "faugus-launcher" - never matched)
//   Heroic    heroic                           (was "Heroic"      - never matched)
//   Goverlay  goverlay                         (was "Goverlay"    - never matched)
// The three wrong ones were silently no-ops: no error, just no rule applied.
// Faugus pattern tolerates GTK reporting bare prgname on its splash (a plain
// Gtk.Window) vs application_id on the main ApplicationWindow.

window-rule {
    match app-id="^steam_app_default$"
    match app-id=r#"^steam_app_\d+$"#
    match app-id="^steam$"
    match app-id=r#"^net\.lutris\.Lutris$"#
    match app-id=r#"(?i)^(io\.github\.faugus\.)?faugus-launcher$"#
    match app-id=r#"(?i)^heroic$"#
    match app-id=r#"(?i)^goverlay$"#
    match app-id="^gamescope$"
    match app-id="^protontricks$"
    open-on-output "DP-3"
}

// Heroic + Steam fill DP-3.
window-rule {
    match app-id=r#"(?i)^heroic$"#
    open-maximized-to-edges true
    open-maximized true
    default-column-width { proportion 1.0; }
}

// Heroic opens auth / download / error screens as separate BrowserViews that
// would otherwise claim a whole tile. Declared AFTER the maximize rule so it wins.
window-rule {
    match app-id=r#"(?i)^heroic$"# title=r#"(?i)sign in|log ?in|connect|authenticat|install|downloading|updat|error|not found|unhandled"#
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 700; }
}

// Lutris: large library list. As a bare float it got niri's small default,
// so pin a usable size on the 2560x1440 output.
window-rule {
    match app-id=r#"^net\.lutris\.Lutris$"#
    open-floating true
    default-column-width { fixed 1500; }
    default-window-height { fixed 950; }
}

window-rule {
    match app-id=r#"(?i)^(io\.github\.faugus\.)?faugus-launcher$"#
    open-floating true
}

// Faugus's log viewer is a distinct window titled "Winetricks Logs".
window-rule {
    match app-id=r#"(?i)^(io\.github\.faugus\.)?faugus-launcher$"# title=r#"^Winetricks Logs$"#
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 520; }
}

window-rule {
    match app-id=r#"(?i)^goverlay$"#
    open-floating true
    default-column-width { fixed 780; }
    default-window-height { fixed 840; }
}

// Goverlay's "What's New" is a second window on the same app-id; passive, so
// leave it unfocused.
window-rule {
    match app-id=r#"(?i)^goverlay$"# title=r#"(?i)what'?s new"#
    open-floating true
    open-focused false
    default-column-width { fixed 720; }
    default-window-height { fixed 580; }
}

// VLC used to float via the old launcher block. Kept floating and un-sized, but
// NOTE: it also gains open-on-output, so it now lands on DP-3 like the other
// media apps instead of wherever it happened to be launched from.
window-rule {
    match app-id="^vlc$"
    open-on-output "DP-3"
    open-floating true
}

// ────────────── Downloads ──────────────
window-rule {
    match app-id=r#"^org\.qbittorrent\.qBittorrent$"#
    open-floating true
}

// Hurtle download manager: the main window floats like qBittorrent's.
window-rule {
    match app-id="^hurtle$"
    open-floating true
    open-on-output "HDMI-A-1"
}

// Hurtle dev and test runs (HURTLE_APP_ID=hurtle-dev / hurtle-test): open on the
// small side monitor without taking focus, so they don't interrupt work on DP-3.
window-rule {
    match app-id="^hurtle-(dev|test)$"
    open-on-output "HDMI-A-1"
    open-floating true
    open-focused false
}

// Hurtle's browser-extension dialog ("Download file info", opened by Zen /
// Brave / Chromium as a popup window). Without this the browser rule above
// would open it maximized on DP-3.
// Chromium/Brave give extension windows their own app-id (chrome-/brave-<extension
// id>-<profile>) and only set the title after mapping, so match the id there.
window-rule {
    match app-id=r#"^[a-z-]+-llabdeoinnakkcncicakgafkjkkjfdgh-"#
    match title=r#"Download file info · Hurtle"#
    open-floating true
    open-focused true
}

// ────────────── Browser pop-ups ──────────────
// Extension pop-up windows and picture-in-picture players float instead of
// taking a tile. PiP stays out of the way in the bottom-right corner.
window-rule {
    match app-id="^zen$" title=r#"(?i)Extension"#
    match app-id="^brave-browser$" title=r#"(?i)Extension"#
    match app-id="^chromium$" title=r#"(?i)Extension"#
    open-floating true
}

window-rule {
    match title=r#"(?i)^Picture[- ]in[- ][Pp]icture$"#
    open-floating true
    open-focused false
    default-column-width { fixed 640; }
    default-window-height { fixed 360; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}
