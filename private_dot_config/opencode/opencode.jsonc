{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "sudo -u *", "effect": "deny" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
  ],
  "plugins": [
    "@plannotator/opencode@latest",
    {
      "package": "opencode-dcp@latest",
      "options": {
        "maxContextLimit": 150000,
      },
    },
  ],
  "mcp": {
    "servers": {
      "browser-control": {
        "type": "local",
        "command": ["browser-control-mcp"],
      },
      "markitdown": {
        "type": "local",
        "command": ["uvx", "markitdown-mcp"],
        "disabled": true,
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": true,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
        "oauth": false,
        "disabled": true,
      },
      "fal-ai": {
        "type": "remote",
        "url": "https://mcp.fal.ai/mcp",
        "headers": {
          "Authorization": "Bearer {env:FAL_AI_API_KEY}",
        },
        "oauth": false,
        "disabled": true,
      },
    },
  },
  "lsp": true,
}
