{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "plugins": [],
  "permissions": [
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo -u *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "doas *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pkexec *",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -rf",
      "effect": "ask"
    },
  ],
  "mcp": {
    "servers": {
      "markitdown": {
        "type": "local",
        "command": [
          "uvx",
          "markitdown-mcp"
        ],
        "disabled": true
      },
      "fal-ai": {
        "type": "remote",
        "url": "https://mcp.fal.ai/mcp",
        "headers": {
          "Authorization": "Bearer {env:FAL_AI_API_KEY}"
        },
        "disabled": true
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      },
      "upwork": {
        "type": "remote",
        "url": "https://mcp.upwork.com/mcp",
        "disabled": true
      }
    }
  },
  "lsp": true,
}
