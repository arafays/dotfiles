{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "sudo -u *", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "pkexec *", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
  ],
  "plugins": ["@plannotator/opencode@latest"],
  "mcp": {
    "servers": {
      "devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "{env:CHROMIUM_PATH}",
        ],
        "disabled": true,
      },
      "markitdown": {
        "type": "local",
        "command": ["uvx", "markitdown-mcp"],
        "disabled": true,
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
      },
      "websearch": {
        "type": "remote",
        "url": ["https://mcp.exa.ai/mcp?exaApiKey=", "{env:EXA_API_KEY}"],
        "oauth": false,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
        "oauth": false,
        "disabled": true,
      },
      "fal-ai": {
        "type": "remote",
        "url": "https://mcp.fal.ai/mcp",
        "headers": {
          "Authorization": "Bearer {env:FAL_AI_API_KEY}",
        },
        "oauth": false,
        "disabled": true,
      },
    },
  },
  "lsp": true,
}
