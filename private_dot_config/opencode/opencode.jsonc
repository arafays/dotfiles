{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "plugins": [
    {
      "package": "opencode-dcp@latest",
      "options": {
        "maxContextLimit": 200000,
      },
    }
  ],
  "mcp": {
    "servers": {
      "markitdown": {
        "type": "local",
        "command": [
          "uvx",
          "markitdown-mcp"
        ],
        "disabled": true
      },
      "fal-ai": {
        "type": "remote",
        "url": "https://mcp.fal.ai/mcp",
        "headers": {
          "Authorization": "Bearer {env:FAL_AI_API_KEY}"
        },
        "disabled": true
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      },
      "upwork": {
        "type": "remote",
        "url": "https://mcp.upwork.com/mcp",
        "disabled": true
      },
      "browser-control": {
        "type": "local",
        "command": [
          "browser-control-mcp"
        ]
      }
    }
  },
}
