{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": [
          "cheap-orchestrator",
          "plan",
        ]
      }
    ],
    "@tarquinen/opencode-dcp@latest",
    "./plugins/herdr-agent-state.js",
  ],
  "permission": {
    "git reset": "deny",
    "sudo": "ask",
    "rm -rf": "ask",
  },
  "mcp": {
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "markitdown-mcp"
      ],
      "enabled": false
    },
    "websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
    },
    "mise": {
      "type": "local",
      "command": [
        "mise",
        "mcp"
      ],
      "enabled": false
    },
    "fal-ai": {
      "type": "remote",
      "url": "https://mcp.fal.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:FAL_AI_API_KEY}"
      },
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    // Drives your real Brave/Chromium profile via a local relay + unpacked
    // extension. Requires the extension loaded at brave://extensions.
    "browser-control": {
      "type": "local",
      "command": [
        "browser-control-mcp"
      ],
      "enabled": true
    }
  },
  "lsp": true,
}
