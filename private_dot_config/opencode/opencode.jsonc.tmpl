{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
    "buffer": 20000,
  },
  "permissions": [
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "sudo -u *", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    { "action": "shell", "resource": "pkexec *", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
  ],
  "plugins": [
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": ["plan"],
      },
    },
    // image-autoload.ts and herdr-agent-state.js load via the global
    // ~/.config/opencode/plugins/ auto-discovery (V2), no entry needed.
  ],
  "mcp": {
    "servers": {
      "devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "{env:CHROMIUM_PATH}",
        ],
        "disabled": true,
      },
      "markitdown": {
        "type": "local",
        "command": ["uvx", "markitdown-mcp"],
        "disabled": true,
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
      },
      "websearch": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?exaApiKey={{ .secrets.exa_api_key }}",
        "oauth": false,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{{ .secrets.context7_api_key }}",
        },
        "oauth": false,
        "disabled": true,
      },
      "fal-ai": {
        "type": "remote",
        "url": "https://mcp.fal.ai/mcp",
        "headers": {
          "Authorization": "Bearer {{ .secrets.fal_ai_api_key }}",
        },
        "oauth": false,
        "disabled": true,
      },
    },
  },
}
