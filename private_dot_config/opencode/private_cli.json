{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "session": {
    "thinking": "show",
    "image_preview": true,
    "scrollbar": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "autoaccept",
    "verbosity": "high",
    "tps": true,
    "grouping": "auto",
    "sidebar": "auto"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "tabs": {
    "enabled": false,
    "layout": "vertical",
    "mode": "auto",
    "scope": "global",
    "indicators": "status"
  },
  "debug": {
    "devtools": false
  },
  "prompt": {
    "paste": "compact"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false
  }
}
