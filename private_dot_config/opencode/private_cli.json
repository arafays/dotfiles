{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "session": {
    "thinking": "show",
    "image_preview": true,
    "scrollbar": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "tabs": {
    "enabled": false,
    "layout": "horizontal"
  },
  "debug": {
    "devtools": false
  },
  "prompt": {
    "paste": "compact"
  },
  "plugins": ["./herdr-opencode"]
}
