{
	"inputs": [
		{
			"id": "memory_file_path",
			"type": "promptString",
			"description": "Path to the memory storage file",
			"default": "${env:HOME}/.config/memory_file",
			"password": false
		},
		{
			"id": "context7_api_key",
			"type": "promptString",
			"description": "Context7 API key (optional; increases rate limits). Get one at https://context7.com/dashboard",
			"password": true
		},
		{
			"id": "fal_ai_api_key",
			"type": "promptString",
			"description": "Fal AI API key (optional; increases rate limits). Get one at https://fal.ai/dashboard",
			"password": true
		},
		{
			"id": "browser_url",
			"type": "promptString",
			"description": "Optional: connect to an already-running Chrome (remote debugging / port-forward). Example: http://127.0.0.1:9222",
			"password": false
		},
		{
			"id": "headless",
			"type": "promptString",
			"description": "Run Chrome headless (true/false). Default: false",
			"password": false,
			"default": "false"
		},
		{
			"id": "isolated",
			"type": "promptString",
			"description": "Use a temporary user-data-dir (true/false). Default: false",
			"password": false,
			"default": "false"
		},
		{
			"id": "chrome_channel",
			"type": "promptString",
			"description": "Chrome channel: stable | canary | beta | dev (default: stable).",
			"password": false,
			"default": "stable"
		},
		{
			"id": "executable_path",
			"type": "promptString",
			"description": "Optional: Path to Chrome/Chromium executable.",
			"password": false
		}
	],
	"servers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "${input:context7_api_key}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"microsoft/markitdown": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"markitdown-mcp"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0",
			"enabled": false
		},
		"fal-ai": {
			"type": "http",
			"url": "https://mcp.fal.ai/mcp",
			"gallery": "https://api.mcp.github.com",
			"headers": {
				"Authorization": "Bearer ${input:fal_ai_api_key}"
			},
			"version": "1.0.0",
			"enabled": false
		}
	}
}