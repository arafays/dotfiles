#!/bin/bash
# chezmoi-refresh-secrets — Cache Bitwarden secrets to .chezmoidata/secrets.yaml
#
# Fetches API keys from Bitwarden and writes them to a data file so that
# chezmoi templates can reference them without unlocking the vault on every
# apply. Run this after changing secrets in Bitwarden.
#
# Usage: chezmoi-refresh-secrets

set -euo pipefail

# Locate chezmoi source directory
SOURCE_DIR="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
DATA_DIR="$SOURCE_DIR/.chezmoidata"
DATA_FILE="$DATA_DIR/secrets.yaml"

mkdir -p "$DATA_DIR"

# ── Bitwarden unlock ──────────────────────────────────────────────
if ! bw status 2>/dev/null | grep -q '"status":"unlocked"'; then
  echo "Unlocking Bitwarden vault..."
  bw_session_key="$(bw unlock --raw)"
  BW_SESSION=${bw_session_key}
  export BW_SESSION
else
  bw_session_key="${BW_SESSION:-}"
fi

echo "→ Syncing Bitwarden vault..."
bw sync

# ── Fetch secrets ─────────────────────────────────────────────────
echo "→ Fetching context7_api_key..."
context7_api_key="$(bw get item "Context7 API Key" | jq -r '.notes')"

echo "→ Fetching exa_api_key..."
exa_api_key="$(bw get item "EXA API Key" | jq -r '.notes')"

echo "→ Fetching fal_ai_api_key..."
fal_ai_api_key="$(bw get item "FAL AI API Key" | jq -r '.notes')"

echo "→ Fetching openrouter_api_key..."
openrouter_api_key="$(bw get item "openrouter key mayabytes" | jq -r '.notes')"

echo "→ Fetching git_identities (multi-line, cached as YAML block scalar)..."
git_identities="$(bw get item "Git Identities" | jq -r '.notes')"

# ── Deploy AUR SSH key ────────────────────────────────────────────
echo "→ Fetching AUR SSH key from Bitwarden..."
aur_item="$(bw get item "AUR SSH Key" || true)"
aur_ssh_key="$(jq -r '.sshKey.privateKey // .notes // empty' <<<"$aur_item")"
aur_ssh_pub="$(jq -r '.sshKey.publicKey // empty' <<<"$aur_item")"

if [[ -n "$aur_ssh_key" ]]; then
  mkdir -p "$HOME/.ssh"
  (
    umask 077
    printf '%s\n' "${aur_ssh_key%$'\n'}" >"$HOME/.ssh/aur_ed25519"
  )
  chmod 600 "$HOME/.ssh/aur_ed25519"
  if [[ -n "$aur_ssh_pub" ]]; then
    printf '%s\n' "${aur_ssh_pub%$'\n'}" >"$HOME/.ssh/aur_ed25519.pub"
    chmod 644 "$HOME/.ssh/aur_ed25519.pub"
  else
    ssh-keygen -y -f "$HOME/.ssh/aur_ed25519" >"$HOME/.ssh/aur_ed25519.pub" 2>/dev/null || true
    chmod 644 "$HOME/.ssh/aur_ed25519.pub"
  fi

  # Ensure ~/.ssh/config points at the key (chezmoi manages this file too)
  if ! grep -q "aur.archlinux.org" "$HOME/.ssh/config" 2>/dev/null; then
    {
      printf '\nHost aur.archlinux.org\n'
      printf '   User aur\n'
      printf '   IdentityFile ~/.ssh/aur_ed25519\n'
      printf '   IdentitiesOnly yes\n'
    } >>"$HOME/.ssh/config"
    chmod 600 "$HOME/.ssh/config"
    echo "→ Added aur.archlinux.org entry to ~/.ssh/config"
  fi
  echo "✓ AUR SSH key deployed to ~/.ssh/aur_ed25519"
else
  echo "⚠ Could not find 'AUR SSH Key' in Bitwarden — skipping SSH key deploy." >&2
fi

# ── Write cache ───────────────────────────────────────────────────
# Single-line secrets are emitted as single-quoted YAML scalars (@Q).
# The multi-line git_identities value is emitted as a literal block scalar (|-).
write_cache() {
  # Indent every line of the multi-line value by 4 spaces so it aligns
  # under the `git_identities: |-` key in the YAML block scalar.
  local gi_block
  gi_block="$(printf '%s\n' "$git_identities" | sed 's/^/    /')" # 4 leading spaces per line
  cat >"$DATA_FILE" <<SECRETS_EOF
# Cached secrets — auto-generated by chezmoi-refresh-secrets
# This is the single source of truth for non-sensitive keys cached from Bitwarden.
# Edit Bitwarden, re-run \`chezmoi-refresh-secrets\`, then \`chezmoi apply\`.
secrets:
  context7_api_key: ${context7_api_key@Q}
  exa_api_key: ${exa_api_key@Q}
  fal_ai_api_key: ${fal_ai_api_key@Q}
  openrouter_api_key: ${openrouter_api_key@Q}
  git_identities: |-
$gi_block
  bw_session: ${bw_session_key@Q}
SECRETS_EOF
}

write_cache

echo "✓ Secrets cached to $DATA_FILE"
echo "→ Run 'chezmoi apply' to use updated values."
