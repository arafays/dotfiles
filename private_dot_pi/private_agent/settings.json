{
  "skills": ["+skills/browser-control/SKILL.md"],
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "commandcode",
  "defaultModel": "deepseek/deepseek-v4-pro",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-rtk-optimizer",
    "npm:@upstash/context7-pi",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-exa",
    "npm:@ff-labs/pi-fff",
    "npm:pi-thinking-steps",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-observational-memory",
    "npm:pi-commandcode-provider",
    "git:github.com/arafays/pi-dcp-advanced"
  ],
  "theme": "dark",
  "hideThinkingBlock": false,
  "showHardwareCursor": false,
  "editorPaddingX": 3,
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "default",
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "ask",
  "transport": "auto",
  "outputPad": 1,
  "steeringMode": "one-at-a-time",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "enabledModels": [
    "opencode-go/deepseek-v4-flash",
    "opencode-go/deepseek-v4-pro",
    "opencode-go/mimo-v2.5",
    "opencode-go/glm-5.2",
    "opencode-go/gpt-5.6-luna",
    "commandcode/deepseek/deepseek-v4-flash",
    "commandcode/deepseek/deepseek-v4-pro"
  ],
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 81000,
    "compactAfterTokensMode": "calibrated",
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "opencode-go",
      "id": "deepseek-v4-flash",
      "thinking": "off"
    },
    "passive": false,
    "debugLog": false
  },
  "subagents": {
    "defaultModel": "opencode-go/mimo-v2.5",
    "defaultThinking": "high",
    "modelScope": {
      "enforce": true,
      "allow": ["opencode-go/*"]
    },
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": ["opencode-go/mimo-v2.5"]
      },
      "delegate": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": ["opencode-go/mimo-v2.5"]
      },
      "researcher": {
        "model": "opencode-go/mimo-v2.5",
        "thinking": "high",
        "fallbackModels": ["opencode-go/deepseek-v4-flash"]
      },
      "worker": {
        "model": "opencode-go/deepseek-v4-flash",
        "thinking": "high",
        "fallbackModels": ["opencode-go/deepseek-v4-pro", "opencode-go/glm-5.2"]
      },
      "reviewer": {
        "model": "opencode-go/glm-5.2",
        "thinking": "high",
        "fallbackModels": ["opencode-go/mimo-v2.5", "opencode-go/deepseek-v4-pro"]
      },
      "oracle": {
        "model": "opencode-go/deepseek-v4-pro",
        "thinking": "max",
        "fallbackModels": ["opencode-go/glm-5.2"]
      },
      "visual": {
        "model": "opencode-go/mimo-v2.5",
        "thinking": "high",
        "fallbackModels": ["opencode-go/gpt-5.6-luna"]
      }
    }
  },
  "autocompleteMaxVisible": 15,
  "httpIdleTimeoutMs": 120000,
  "collapseChangelog": true
}
